# Sao chép file này thành config.env (KHÔNG đưa config.env lên git) rồi điền giá trị.
# Bỏ trống GOOGLE_CLIENT_ID = tắt đăng nhập (dùng nội bộ trên 1 máy).

# --- Đăng nhập Google: tạo tại https://console.cloud.google.com/apis/credentials
#     Loại "OAuth client ID" -> "Web application"
#     Authorized redirect URI: <PUBLIC_URL>/auth/callback  (vd http://localhost:8000/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ai được dùng (phân cách dấu phẩy). Để trống cả hai = mọi tài khoản Google (không khuyến nghị)
AUTH_ALLOWED_DOMAINS=congty.com.vn
AUTH_ALLOWED_EMAILS=
AUTH_ADMIN_EMAILS=

# --- Chuỗi bí mật ký cookie phiên (đặt cố định để không bị đăng xuất khi khởi động lại máy chủ)
SESSION_SECRET=

# --- Địa chỉ công khai của trang (khi chạy sau proxy / tên miền riêng)
PUBLIC_URL=http://localhost:8000

# --- Trợ lý AI dùng chung key của máy chủ (tuỳ chọn)
ANTHROPIC_API_KEY=
